# Copie para .env.local e preencha. NUNCA commite chaves reais.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secreta: só no servidor (webhooks, ações de sistema). Nunca prefixar com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Endereço público do site (links nos e-mails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=LC.Academy

# Testes de banco (Postgres onde o usuário pode criar bancos)
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# Bunny Stream (aulas pagas). Library ID e a chave de "Token Authentication" (Stream > Security).
BUNNY_LIBRARY_ID=
BUNNY_TOKEN_KEY=

# E-mail (Resend): envio dos e-mails de acesso pelo próprio site
RESEND_API_KEY=
EMAIL_FROM="LC.Academy <acesso@seudominio.com.br>"

# Webhooks das plataformas de pagamento (preencha só as que usar)
KIWIFY_WEBHOOK_TOKEN=
HOTMART_HOTTOK=
YAMPI_WEBHOOK_SECRET=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_ACCESS_TOKEN=
ASAAS_WEBHOOK_TOKEN=
ASAAS_API_KEY=
# Sandbox do Asaas: https://api-sandbox.asaas.com/v3
ASAAS_API_URL=https://api.asaas.com/v3

# IA (opcional, desligada por decisão de custo): chave da API da Anthropic. Secreta.
ANTHROPIC_API_KEY=

# WhatsApp (Etapa 3): API oficial da Meta (padrão) ou Z-API (WHATSAPP_PROVIDER=zapi). Secretas.
WHATSAPP_PROVIDER=meta
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
# Modelo aprovado com corpo "Olá, {{1}}! {{2}}" (sem ele, só chega para quem falou com o número nas últimas 24 h)
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=pt_BR
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# Envios automáticos: senha que a Vercel usa para chamar /api/cron/diario (todo dia às 9h)
CRON_SECRET=
